# ── Sistema sob teste ──────────────────────────────────────────────
# URL da API publicada (sem /api no final) e URL do frontend publicado.
SRGOP_API_URL=https://srgop.onrender.com
SRGOP_WEB_URL=https://srgop.vercel.app
# Mesmo valor configurado em SIMULATION_BYPASS_TOKEN no backend (Render).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIMULATION_BYPASS_TOKEN=

# ── Contas ─────────────────────────────────────────────────────────
# Senha única das 87 contas fictícias (mínimo 10 caracteres).
SIM_PASSWORD=
# Conta Administrativo existente, usada SOMENTE pelo "npm run seed".
SIM_ADMIN_EMAIL=
SIM_ADMIN_PASSWORD=

# ── Simulação ──────────────────────────────────────────────────────
SIM_DAYS=1
SIM_OCORRENCIAS_MIN_HORA=5
SIM_OCORRENCIAS_MAX_HORA=10
# Fração das ocorrências lançadas por uma guarnição para OUTRA cidade.
SIM_TAXA_OUTRA_CIDADE=0.08
# Fração das ocorrências cadastradas pelo próprio CPU.
SIM_TAXA_CPU=0.05
SIM_TAXA_REJEICAO=0.05
SIM_TAXA_APOIO=0.07
SIM_GPS_INTERVALO_S=15
# Atores em navegador real (CPU + guarnições em rodízio). 0 desliga.
SIM_ATORES_NAVEGADOR=3
# Retomar sozinho quando o sistema voltar após indisponibilidade.
SIM_AUTO_RETOMAR=true
# A tela de login vem com "lembrar" desmarcado (sessão de 12h). false reproduz isso.
SIM_LEMBRAR_LOGIN=false
SIM_LENTIDAO_MS=3000

# ── IA: Cloudflare Workers AI (opcional) ────────────────────────────
# ID da conta: painel da Cloudflare > Workers AI (ou na barra lateral da conta).
# Token: My Profile > API Tokens > modelo "Workers AI" (permissões Workers AI Read e Edit).
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Cota gratuita: 10.000 neurônios/dia (zera às 00:00 UTC); ~100 chamadas com o modelo acima.
IA_LIMITE_DIARIO=100

# ── Limpeza final (opcional, somente "npm run limpar") ─────────────
MONGO_URI=

# Envia delegacia e apreensões no encerramento. Ligue (true) só depois de publicar o backend que aceita esses campos.
SIM_DETALHES_ENCERRAMENTO=false
